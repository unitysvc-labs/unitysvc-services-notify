"""Connectivity test for a container service: start the instance, fetch its entries, stop it.

A container service has no gateway route, so the test drives the enrollment's instance through the
customer API, as the ops customer (UNITYSVC_API_KEY, UNITYSVC_API_URL, UNITYSVC_ENROLLMENT_ID).
Exit status: 0 the instance came up and every entry answered, 75 the platform failed (the cluster is
down, busy or unconfigured; retry later), 1 the service failed (it never became ready or an entry
does not answer).
"""
{% if local_testing %}
print("connectivity ok (a container service is tested locally with Docker by the seller CLI)")
{% else %}
import json
import os
import sys
import time
import urllib.error
import urllib.request

API = os.environ["UNITYSVC_API_URL"].rstrip("/")
KEY = os.environ["UNITYSVC_API_KEY"]
INSTANCE = f"{API}/enrollments/{os.environ['UNITYSVC_ENROLLMENT_ID']}/instance"
START_TIMEOUT = 180  # seconds for the cluster to start the instance
ENTRY_TIMEOUT = 60  # seconds for the route of a fresh instance to settle
PLATFORM_FAULT = 75


def call(method, url, key=KEY, timeout=70):
    """(status, parsed JSON or text); status 0 when nothing answered."""
    request = urllib.request.Request(url, method=method, data=b"" if method == "POST" else None)
    if key:
        request.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            status, body = response.status, response.read().decode()
    except urllib.error.HTTPError as error:
        status, body = error.code, error.read().decode()
    except (urllib.error.URLError, OSError) as error:
        return 0, str(error)
    try:
        return status, json.loads(body)
    except ValueError:
        return status, body


def platform_down(status):
    """The control plane did not answer (0) or answered 5xx: the platform's problem, retry later."""
    return status == 0 or status >= 500


def fail(message, code=1):
    print(f"connectivity failed: {message}", file=sys.stderr)
    return code


def run():
    status, state = call("POST", f"{INSTANCE}/start")
    if platform_down(status):
        return fail(f"the platform could not take the request ({status}: {state})", PLATFORM_FAULT)
    if status != 202:
        return fail(f"start was refused: HTTP {status} {state}")
    deadline = time.monotonic() + START_TIMEOUT
    while state.get("status") not in ("succeeded", "failed"):
        if time.monotonic() > deadline:
            return fail(f"the instance was not ready in {START_TIMEOUT}s (status {state.get('status')})", PLATFORM_FAULT)
        status, state = call("GET", f"{INSTANCE}?wait=30")
        if status != 200:
            return fail(f"status read failed: HTTP {status} {state}", PLATFORM_FAULT if platform_down(status) else 1)
    if state["status"] == "failed":
        code = PLATFORM_FAULT if state.get("fault") == "platform" else 1
        return fail(f"the instance failed: {state.get('reason')} (fault: {state.get('fault')})", code)
    print(f"instance up: {len(state.get('components') or [])} pod(s)")

    key = None
    for entry in state.get("entries") or []:
        headers_key = None
        if entry.get("auth") == "app":
            if key is None:
                status, creds = call("GET", f"{INSTANCE}/credentials")
                if status != 200:
                    return fail(
                        f"could not read the instance key: HTTP {status}",
                        PLATFORM_FAULT if platform_down(status) else 1,
                    )
                key = creds["key"]
            headers_key = key
        last = None
        end = time.monotonic() + ENTRY_TIMEOUT
        while time.monotonic() < end:
            # Not settled yet: the route of a fresh instance answers 404/502/503/504 for a little while.
            status, _ = call("GET", entry["url"], key=headers_key, timeout=15)
            last = status
            if 200 <= status < 400:
                print(f"{entry['name']}: HTTP {status}")
                break
            if status not in (0, 404, 502, 503, 504):
                break
            time.sleep(3)
        if not (last and 200 <= last < 400):
            return fail(f"entry {entry['name']!r} at {entry['url']} answered HTTP {last}")
    print("connectivity ok")
    return 0


try:
    code = run()
finally:
    call("POST", f"{INSTANCE}/stop")  # the platform also removes it after the run
sys.exit(code)
{% endif %}
