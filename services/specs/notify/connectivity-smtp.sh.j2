#!/bin/bash
# Connectivity test for notify's smtp_gateway (SMTP) access interface — the
# same gateway-native notify://user primitive as connectivity-http.sh.j2,
# reached over SMTP for callers that can only send email. See that file for
# why this is a separate document rather than a runtime branch in one.
set -o pipefail

{% if local_testing %}
echo "connectivity ok (gateway-native notify://user, no upstream)"
{% else %}
URL="{{ service_base_url }}"
if [[ "$URL" != smtp://* && "$URL" != smtps://* ]]; then
    echo "connectivity ok (not applicable to the canonical interface)"
    exit 0
fi

# curl does not translate line endings for an SMTP upload -- a plain
# heredoc would emit bare-LF-terminated lines, which Haraka's
# SMTP-smuggling hardening rejects outright (451 Bare line-feed). Build
# the message with explicit CRLF instead.
printf 'From: test@example.com\r\nTo: recipient@example.com\r\nSubject: notify connectivity\r\n\r\nconnectivity probe\r\n' \
  | curl --silent --show-error --ssl --url "$URL" \
    --user "{{ routing_key.username }}:${UNITYSVC_API_KEY:?set UNITYSVC_API_KEY to your svcpass}" \
    --mail-from "test@example.com" --mail-rcpt "recipient@example.com" \
    --upload-file -
status=$?

if [ "$status" -eq 0 ]; then
    echo "connectivity ok (SMTP submission accepted)"
    exit 0
fi
echo "connectivity failed: SMTP submission rejected (curl exit $status)" >&2
exit 1
{% endif %}
