{
  "currency": "USD",
  "display_name": "Notify Me",
  "documents": {
    "Connectivity test": {
      "category": "connectivity_test",
      "description": "Runs once per access interface: POST the msg envelope over HTTP, or submit a message over SMTP -- both expect success",
      "file_path": "connectivity.sh.j2",
      "is_active": true,
      "is_public": true,
      "meta": {
        "output_contains": "connectivity ok"
      },
      "mime_type": "bash"
    },
    "Python code example": {
      "category": "code_example",
      "description": "Python (httpx) example — send yourself a notification via the msg envelope",
      "file_path": "code-example.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {
        "output_contains": "sent",
        "requirements": [
          "httpx"
        ]
      },
      "mime_type": "python"
    }
  },
  "list_price": {
    "description": "Free | delivery to any external destination you've configured is billed by that destination's own listing, if it has a cost",
    "price": "0",
    "type": "constant"
  },
  "name": "notify",
  "status": "ready",
  "time_created": "2026-09-06T00:00:00Z",
