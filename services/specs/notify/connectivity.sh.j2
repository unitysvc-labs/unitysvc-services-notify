#!/bin/bash
# Connectivity test for notify — the gateway-native notify://user primitive
# (unitysvc#1526). There is NO seller upstream: the gateway short-circuits
# the request and the platform backend queues delivery.
#
# notify has two access interfaces (canonical/HTTP, smtp_gateway/SMTP) that
# both route through the same shared upstream channel, and this one document
# runs once per active interface -- {{ service_base_url }} resolves to
# whichever interface's own base_url this render is for, so branch on its
# scheme at runtime (same pattern smtp-to-http's connectivity test uses).
#
#   local_testing : there is no server to reach — the response is produced by
#                   the gateway itself (cf. the resp:// services). This branch
#                   always passes; it exists only to confirm wiring.
#   gateway, http : POST the canonical msg envelope and expect 2xx.
#   gateway, smtp : submit a real message over SMTP and expect the
#                   transaction to complete (250 after DATA).
set -o pipefail

{% if local_testing %}
echo "connectivity ok (gateway-native notify://user, no upstream)"
{% else %}
URL="{{ service_base_url }}"

if [[ "$URL" == smtp://* || "$URL" == smtps://* ]]; then
    # curl does not translate line endings for an SMTP upload -- a plain
    # heredoc would emit bare-LF-terminated lines, which Haraka's
    # SMTP-smuggling hardening rejects outright (451 Bare line-feed). Build
    # the message with explicit CRLF instead.
    printf 'From: test@example.com\r\nTo: recipient@example.com\r\nSubject: notify connectivity\r\n\r\nconnectivity probe\r\n' \
      | curl --silent --show-error --ssl --url "$URL" \
        --user "{{ routing_key.username }}:${UNITYSVC_API_KEY:?set UNITYSVC_API_KEY to your svcpass}" \
        --mail-from "test@example.com" --mail-rcpt "recipient@example.com" \
        --upload-file -
    status=$?
    if [ "$status" -eq 0 ]; then
        echo "connectivity ok (SMTP submission accepted)"
        exit 0
    fi
    echo "connectivity failed: SMTP submission rejected (curl exit $status)" >&2
    exit 1
fi

response=$(curl -sS --max-time 10 \
    -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
    -d '{"title":"notify connectivity","body":"connectivity probe","type":"info","format":"text"}' \
    -w "\n%{http_code}" \
    "$URL" 2>/dev/null)
status="${response##*$'\n'}"
body="${response%$'\n'*}"

case "$status" in
  2??) echo "connectivity ok (HTTP $status)"; exit 0 ;;
  000) echo "connectivity failed: could not connect to $URL" >&2; exit 1 ;;
  *)   echo "connectivity failed: HTTP $status from $URL: ${body}" >&2; exit 1 ;;
esac
{% endif %}
