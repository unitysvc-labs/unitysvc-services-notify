#!/bin/bash
# Simulate what the WebhookBridge bot posts for one Discord message, and send it
# through labs/discord-to-msg. In production WebhookBridge itself posts this
# shape to the connector's webhook URL (Rooms → the room → Delivery → the
# connector), https://api.svcpass.com/webhook/<KEY>/labs/discord-to-msg/<connector id>,
# which carries the key in the URL because WebhookBridge sets no headers. This
# example sends the key as a header instead, which the gateway takes equally,
# and names no connector, so the message lands in the caller's own `me` room.
#   local_testing : there is no upstream to reach (gateway-native rooms://post).
#   gateway       : POST the WebhookBridge event to the service (Bearer auth).
set -o pipefail

{% if local_testing %}
echo "delivered (skipped: gateway-native rooms://post, no upstream)"
exit 0
{% else %}
URL="{{ service_base_url }}"
status=$(curl -sS --max-time 15 \
    -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
    -d '{"event_type":"discord.message.created","guild_id":"123456789012345678","channel_id":"234567890123456789","message_id":"345678901234567890","user_id":"456789012345678901","username":"exampleuser","display_name":"Example User","message":"Hello from **Discord**","attachments":[{"url":"https://cdn.discordapp.com/attachments/1/2/photo.png","filename":"photo.png","content_type":"image/png","size":12345}],"timestamp":"2026-11-05T12:00:00.000Z"}' \
    -o /dev/null -w "%{http_code}" \
    "$URL" 2>/dev/null)

case "$status" in
  2??) echo "delivered (HTTP $status)"; exit 0 ;;
  000) echo "send failed: could not connect to $URL" >&2; exit 1 ;;
  *)   echo "send failed: HTTP $status from $URL" >&2; exit 1 ;;
esac
{% endif %}
