{
  "currency": "USD",
  "display_name": "{{ display_name }}",
  "documents": {
{%- if transformer_channel_exists | default(false) %}
    {#- The apprise channels are disabled on transformer services, so their
        docs would describe an unreachable path. Ship the gateway ones only. -#}
    "Connectivity test": { "$doc_preset": { "name": "{{ gateway_connectivity_preset }}", "local_url": {{ gateway_test_local_url | tojson }}, "channel": "gateway", "meta": { "channels": ["gateway"] } } },
    "Python code example": { "$doc_preset": { "name": "{{ gateway_code_example_preset }}", "local_url": {{ gateway_test_local_url | tojson }}, "channel": "gateway", "meta": { "channels": ["gateway"] } } }
{%- else %}
    "Connectivity test": {
      "$doc_preset": {
        "name": "{{ connectivity_preset }}",
        "apprise_url": "{{ test_apprise_url | default('') }}",
        "meta": { "channels": ["apprise"] }
      }
    },
    "Python code example": {
      "$doc_preset": {
        "name": "{{ code_example_preset }}",
        "apprise_url": "{{ test_apprise_url | default('') }}",
        "meta": { "channels": ["apprise"] }
      }
    }
{%- endif %}
  },
  "list_price": {
    "channels": {
{%- if transformer_channel_exists | default(false) %}
      "gateway": { "description": {{ gateway_price_description | default('Free — direct to your own endpoint (no Apprise)') | tojson }}, "price": "0", "type": "constant" },
      "gateway-plus": { "description": {{ gateway_plus_price_description | default('$0.001 / message — extra per-enrollment destinations, direct') | tojson }}, "price": "{{ plus_price | default('0.001') }}", "type": "constant" }
{%- else %}
      "apprise": {
        "description": {{ apprise_price_description | default('Free — send notifications to your own channel') | tojson }},
        "price": "0",
        "type": "constant"
      },
      "apprise-plus": {
        "description": {{ apprise_plus_price_description | default('$0.001 / message — extra per-enrollment destinations') | tojson }},
        "price": "{{ plus_price | default('0.001') }}",
        "type": "constant"
      }
{%- endif %}
    },
    "default": "{{ 'gateway' if transformer_channel_exists | default(false) else 'apprise' }}",
{%- set _plus = plus_price | default('0.001') %}
    "price": "{{ _plus }}",
    "description": {{ list_price_description | default('Free' if _plus == '0' else 'Free - $' ~ _plus ~ ' / message') | tojson }},
    "type": "channel"
  },
  "name": "labs/{{ channel_name }}",
  "service_options": {
{%- if default_visibility is defined %}
    "default_visibility": {{ default_visibility | tojson }},
{%- endif %}
    "ops_testing_parameters": {{ ops_testing_parameters | tojson }}
  },
  "status": "{{ status | default('ready') }}",
  "time_created": "{{ time_created | default('2026-06-19T00:00:00Z') }}",
  "user_access_interfaces": {
    "canonical": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{% raw %}{{ service_name }}{% endraw %}"
    }
  },
  "user_parameters_schema": {{ user_parameters_schema | tojson }}
}
