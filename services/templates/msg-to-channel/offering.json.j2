{%- set apprise_tail = '","title":{* _escape_json(_body.title or "") *},"body":{* _escape_json(_body.body or "") *},"type":{* _escape_json(_body.type or "info") *},"format":{* _escape_json(_body.format or "text") *}}' -%}
{
  "capabilities": [
    "deliver-message"
  ],
  "description": {{ description | tojson }},
  "details": {
    "input_formats": ["msg"]
  },
{%- if logo %}
{#- The `logo` convenience field is a bare URL, so there is nowhere to record
    where that URL came from. Mirroring rewrites `external_url` to the
    platform's own `${UNITYSVC_S3_BASE_URL}/<content-key>` form, and once it
    does, the original is lost — which is why every upload re-fetches every
    logo from its origin CDN. Authoring the document explicitly keeps the
    source in `meta.source_url`, so a later upload can recognise an already
    mirrored logo instead of downloading it again.
    See unitysvc/unitysvc-sellers#193. -#}
{%- set _logo_lower = logo | lower %}
{%- if _logo_lower.endswith('.png') %}{% set _logo_mime = 'png' %}
{%- elif _logo_lower.endswith('.jpg') or _logo_lower.endswith('.jpeg') %}{% set _logo_mime = 'jpeg' %}
{%- elif _logo_lower.endswith('.svg') %}{% set _logo_mime = 'svg' %}
{%- else %}{% set _logo_mime = 'url' %}{% endif %}
  "documents": {
    "Company Logo": {
      "category": "logo",
      "external_url": {{ logo | tojson }},
      "is_public": true,
      "meta": { "source_url": {{ logo | tojson }} },
      "mime_type": {{ _logo_mime | tojson }}
    }
  },
{%- endif %}
  "name": "{{ channel_name }}",
  "service_type": "notification",
  "status": "{{ status | default('ready') }}",
  "summary": {{ summary | tojson }},
  "time_created": "{{ time_created | default('2026-06-19T00:00:00Z') }}",
  "upstream_access_config": {
    "apprise": {
      "access_method": "http",
{%- if transformer_channel_exists | default(false) %}
      {#- A native `gateway` channel delivers straight to the provider's own
          API, so the Apprise relay is redundant here — and it is a path we
          cannot exercise end-to-end against the real destination. Keep the
          definition as documentation/fallback but disabled; the backend
          honors is_active everywhere channels are read
          (unitysvc/unitysvc#1844). Apprise-only services (no transformer)
          keep this channel active — it is their sole delivery path. -#}
      "is_active": false,
{%- endif %}
      "sort_order": 2,
      "base_url": "${ customer_secrets.APPRISE_BASE ?? https://apprise.unitysvc.dev }/notify",
      "raw": {
        "request_transformer": {
          "body_transformer": {
            "request": {
              "input_format": "json",
              "template": {{ ('{"urls":"' ~ apprise_url ~ apprise_tail) | tojson }}
            }
          }
        }
      }
    },
    "apprise-plus": {
      "access_method": "http",
{%- if transformer_channel_exists | default(false) %}
      {#- With the transformer gateway-plus channel present, this would be a
          SECOND enrollable channel — against the at-most-one-enrollable rule
          (enrollments associate with exactly one channel). Keep the
          definition as documentation/fallback but disabled; the backend
          honors is_active everywhere channels are read
          (unitysvc/unitysvc#1844). Apprise-only services (no transformer)
          keep this channel active — it is their sole enrollable. -#}
      "is_active": false,
{%- endif %}
      "sort_order": 4,
      "base_url": "${ customer_secrets.APPRISE_BASE ?? https://apprise.unitysvc.dev }/notify",
      "raw": {
        "request_transformer": {
          "body_transformer": {
            "request": {
              "input_format": "json",
              "template": {{ ('{"urls":"' ~ apprise_url_plus ~ apprise_tail) | tojson }}
            }
          }
        }
      }
    }
{%- if transformer_channel_exists | default(false) %}
    ,"gateway": {
      "access_method": "http",
      {%- if gateway_api_key is defined %}
      "api_key": {{ gateway_api_key | tojson }},
      {%- endif %}
      "sort_order": 1,
      "base_url": {{ gateway_url | tojson }},
      "raw": { "request_transformer": {
        "body_transformer": { "request": { "input_format": "json", "template": {{ gateway_body_template | tojson }} } },
        "proxy_rewrite": { "headers": { "set": { "Content-Type": {{ gateway_content_type | default('application/json') | tojson }}{% if gateway_extra_headers is defined %}{% for hk, hv in gateway_extra_headers.items() %}, {{ hk | tojson }}: {{ hv | tojson }}{% endfor %}{% endif %} } } }
      } }
    },
    "gateway-plus": {
      "access_method": "http",
      {%- if gateway_api_key is defined %}
      "api_key": {{ gateway_api_key | tojson }},
      {%- endif %}
      "sort_order": 3,
      "base_url": {{ gateway_url_plus | tojson }},
      "raw": { "request_transformer": {
        "body_transformer": { "request": { "input_format": "json", "template": {{ gateway_body_template | tojson }} } },
        "proxy_rewrite": { "headers": { "set": { "Content-Type": {{ gateway_content_type | default('application/json') | tojson }}{% if gateway_extra_headers is defined %}{% for hk, hv in gateway_extra_headers.items() %}, {{ hk | tojson }}: {{ hv | tojson }}{% endfor %}{% endif %} } } }
      } }
    }
{%- endif %}
  }
}
